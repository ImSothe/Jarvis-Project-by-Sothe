# Copy this file to .env and fill in your own keys. Never commit the real .env.
#
# This project defaults to Google Gemini. Get a free key at
# https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional — only needed if you switch the default model to one of these
# providers (see ~/.openjarvis/config.toml -> [intelligence] default_model).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Instagram (professional account). Token lasts ~60 days.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# YouTube Data API key (free) for find_viral_videos. Not OAuth: just an API key.
YOUTUBE_API_KEY=

# Optional voice direction for Gemini TTS and Edge pitch (e.g. -12Hz)
GEMINI_TTS_STYLE=
OPENJARVIS_EDGE_PITCH=
